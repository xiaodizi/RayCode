{
  "name": "@hkuds/raycode",
  "version": "0.1.0",
  "description": "RayCode - Open Agentic Coding Platform",
  "keywords": ["raycode", "paper2code", "text2web", "agentic"],
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "raycode": "src/cli/main.ts"
  },
  "scripts": {
    "start": "bun run src/cli/main.ts",
    "dev": "bun run --watch src/cli/main.ts",
    "build": "bun build src/cli/main.ts --outdir dist --target bun --external *",
    "test": "bun test",
    "clean": "rm -rf dist node_modules bun.lock",
    "typecheck": "bun run tsc --noEmit",
    "start:web": "bun run src/web/main.ts",
    "dev:web": "bun run --watch src/web/main.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.2",
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0-rc.12",
    "clsx": "^2.0.0",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-ws": "^5.0.2",
    "figlet": "^1.7.0",
    "framer-motion": "^10.16.16",
    "highlight.js": "^11.11.1",
    "ink": "^6.8.0",
    "ink-testing-library": "^4.0.0",
    "openai": "^4.24.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "recharts": "^2.10.3",
    "treeify": "^1.1.0",
    "ws": "^8.14.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/ws": "^8.5.10",
    "typescript": "^5.3.3"
  },
  "trustedDependencies": ["@anthropic-ai/sdk", "openai"],
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "author": "HKUDS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HKUDS/RayCode.git"
  },
  "bugs": {
    "url": "https://github.com/HKUDS/RayCode/issues"
  },
  "homepage": "https://github.com/HKUDS/RayCode#readme"
}